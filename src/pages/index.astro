  <!-- ==========================================
       INTERACTIVE FULL-SCREEN ZOOMABLE LIGHTBOX MODAL
       (With Next/Prev Navigation, Zoom Controls & Keyboard Support)
       ========================================== -->
  <div
    id="cert-lightbox"
    role="dialog"
    aria-modal="true"
    aria-labelledby="lightbox-title"
    aria-hidden="true"
    class="fixed inset-0 z-[100] hidden items-center justify-center overflow-y-auto bg-slate-950/90 backdrop-blur-2xl p-3 sm:p-6"
  >
    <!-- Backdrop Click Area -->
    <div id="lightbox-backdrop" class="fixed inset-0"></div>

    <!-- Modal Container -->
    <div
      class="relative z-10 my-auto flex w-full max-w-4xl flex-col max-h-[90vh] overflow-y-auto rounded-2xl border border-cyan-500/35 bg-slate-900/95 light:bg-white shadow-[0_0_60px_rgba(6,182,212,0.25)]"
    >
      <!-- Top Control Bar -->
      <div class="sticky top-0 z-30 flex flex-wrap items-center justify-between gap-3 border-b border-cyan-500/20 bg-slate-900/95 light:bg-white/95 backdrop-blur-md px-4 py-3 sm:px-6">
        <div class="flex items-center gap-2.5">
          <span
            id="lightbox-category"
            class="rounded-full border border-cyan-500/35 bg-cyan-500/15 px-3 py-0.5 text-xs font-semibold text-cyan-300 light:text-cyan-800"
          >
            Category
          </span>
          <span
            id="lightbox-counter"
            class="text-xs font-medium text-theme-muted"
          >
            1 / 13
          </span>
        </div>

        <!-- Zoom & Close Controls -->
        <div class="flex items-center gap-2">
          <button
            id="lightbox-zoom-out"
            type="button"
            aria-label="Zoom Out"
            class="flex h-8 w-8 items-center justify-center rounded-[6px] border border-cyan-500/25 bg-slate-800/80 light:bg-slate-100 text-xs font-bold text-theme-heading hover:border-cyan-400 cursor-pointer"
          >
            −
          </button>
          <button
            id="lightbox-zoom-reset"
            type="button"
            aria-label="Reset Zoom"
            class="flex h-8 items-center justify-center rounded-[6px] border border-cyan-500/25 bg-slate-800/80 light:bg-slate-100 px-2.5 text-xs font-semibold text-cyan-400 hover:border-cyan-400 cursor-pointer"
          >
            100%
          </button>
          <button
            id="lightbox-zoom-in"
            type="button"
            aria-label="Zoom In"
            class="flex h-8 w-8 items-center justify-center rounded-[6px] border border-cyan-500/25 bg-slate-800/80 light:bg-slate-100 text-xs font-bold text-theme-heading hover:border-cyan-400 cursor-pointer"
          >
            +
          </button>
          <a
            id="lightbox-open-raw"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex h-8 items-center rounded-[6px] border border-cyan-500/25 bg-slate-800/80 light:bg-slate-100 px-2.5 text-xs font-medium text-theme-heading hover:border-cyan-400"
          >
            Full File ↗
          </a>
          <button
            id="lightbox-close"
            type="button"
            aria-label="Close Lightbox (Esc)"
            class="flex h-8 w-8 items-center justify-center rounded-[6px] border border-rose-500/35 bg-rose-500/15 text-rose-300 light:text-rose-700 hover:bg-rose-500/30 cursor-pointer"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Center Image Viewport with Prev/Next Controls -->
      <div class="relative overflow-auto bg-slate-950/90 flex items-center justify-center p-4 sm:p-6 select-none">
        <!-- Prev Button -->
        <button
          id="lightbox-prev"
          type="button"
          aria-label="Previous Certificate"
          class="absolute left-3 z-20 flex h-10 w-10 items-center justify-center rounded-full border border-cyan-500/40 bg-slate-950/85 text-cyan-400 shadow-lg hover:bg-cyan-500 hover:text-slate-950 transition-colors cursor-pointer"
        >
          ←
        </button>

        <!-- Zoomable Certificate Image -->
        <div id="lightbox-img-wrapper" class="transition-transform duration-200 ease-out origin-center">
          <img
            id="lightbox-img"
            src=""
            alt=""
            class="max-h-[50vh] sm:max-h-[55vh] w-auto max-w-full rounded-lg object-contain shadow-2xl mx-auto"
          />
        </div>

        <!-- Next Button -->
        <button
          id="lightbox-next"
          type="button"
          aria-label="Next Certificate"
          class="absolute right-3 z-20 flex h-10 w-10 items-center justify-center rounded-full border border-cyan-500/40 bg-slate-950/85 text-cyan-400 shadow-lg hover:bg-cyan-500 hover:text-slate-950 transition-colors cursor-pointer"
        >
          →
        </button>
      </div>

      <!-- Bottom Metadata Caption Bar (Always Fully Visible & Unclipped) -->
      <div class=" shrink-0 border-t border-cyan-500/20 bg-slate-900/95 light:bg-slate-50 px-5 py-4 sm:px-6 sm:py-5">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
          <h3 id="lightbox-title" class="text-base sm:text-lg font-bold text-theme-heading">
            Certificate Title
          </h3>
          <span id="lightbox-date" class="text-xs font-semibold text-cyan-400">
            Date
          </span>
        </div>
        <div id="lightbox-issuer" class="text-xs font-semibold text-emerald-400 mb-2">
          Issuer
        </div>
        <p id="lightbox-summary" class="text-xs sm:text-sm text-theme-body leading-relaxed">
          Summary
        </p>
      </div>
    </div>
  </div>

  <!-- Client-Side Interactive Scripts -->
  <script is:inline>
    (function () {
      // 1. Scroll Progress Indicator
      const progressBar = document.getElementById('scroll-progress');
      function updateScrollProgress() {
        if (!progressBar) return;
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const docHeight =
          document.documentElement.scrollHeight -
          document.documentElement.clientHeight;
        const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
        progressBar.style.width = pct + '%';
      }
      window.addEventListener('scroll', updateScrollProgress, { passive: true });
      updateScrollProgress();

      // 2. IntersectionObserver Scroll-Reveal
      const revealEls = document.querySelectorAll('.reveal-on-scroll');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => observer.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // 3. Mouse-Tracking Spotlight Glow on .cyber-card
      const cards = document.querySelectorAll('.cyber-card');
      cards.forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', x + 'px');
          card.style.setProperty('--mouse-y', y + 'px');
        });
      });

      // 4. Dark / Light Theme Toggle
      const themeToggleBtn = document.getElementById('theme-toggle');
      const sunIcon = document.getElementById('theme-icon-sun');
      const moonIcon = document.getElementById('theme-icon-moon');

      function syncThemeIcons() {
        const isLight = document.documentElement.classList.contains('light');
        if (sunIcon && moonIcon) {
          sunIcon.classList.toggle('hidden', isLight);
          moonIcon.classList.toggle('hidden', !isLight);
        }
      }
      syncThemeIcons();

      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
          const html = document.documentElement;
          const isCurrentlyLight = html.classList.contains('light');
          if (isCurrentlyLight) {
            html.classList.remove('light');
            html.classList.add('dark');
            try {
              localStorage.setItem('theme', 'dark');
            } catch (e) {}
          } else {
            html.classList.remove('dark');
            html.classList.add('light');
            try {
              localStorage.setItem('theme', 'light');
            } catch (e) {}
          }
          syncThemeIcons();
        });
      }

      // 5. Mobile Menu Toggle
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener('click', () => {
          const expanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
          mobileMenuBtn.setAttribute('aria-expanded', String(!expanded));
          mobileMenu.classList.toggle('hidden');
        });
        mobileMenu.querySelectorAll('.mobile-nav-link').forEach((link) => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
            mobileMenuBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      // 6. Interactive Category Filter Tabs — Section A (Achievements)
      const achievementTabs = document.querySelectorAll('.achievement-tab-btn');
      const achievementCards = document.querySelectorAll('.achievement-card');

      achievementTabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selectedCat = btn.getAttribute('data-achievement-filter') || 'All';
          achievementTabs.forEach((b) => {
            const active = b === btn;
            b.setAttribute('aria-selected', String(active));
            b.className = active
              ? 'achievement-tab-btn inline-flex h-9 items-center gap-2 rounded-full border px-4 text-xs font-semibold transition-all cursor-pointer border-cyan-400 bg-cyan-500/20 text-cyan-300 light:text-cyan-900 shadow-[0_0_16px_rgba(6,182,212,0.25)]'
              : 'achievement-tab-btn inline-flex h-9 items-center gap-2 rounded-full border px-4 text-xs font-semibold transition-all cursor-pointer border-cyan-500/20 bg-slate-900/50 light:bg-slate-100 text-theme-body hover:border-cyan-500/40 hover:text-theme-heading';
          });

          achievementCards.forEach((card) => {
            const cardCat = card.getAttribute('data-category');
            if (selectedCat === 'All' || cardCat === selectedCat) {
              card.classList.remove('is-hidden');
            } else {
              card.classList.add('is-hidden');
            }
          });
        });
      });

      // 7. Interactive Category Filter Tabs — Section B (Certifications)
      const certTabs = document.querySelectorAll('.cert-tab-btn');
      const certCards = Array.from(document.querySelectorAll('.cert-card'));

      certTabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selectedCat = btn.getAttribute('data-cert-filter') || 'All';
          certTabs.forEach((b) => {
            const active = b === btn;
            b.setAttribute('aria-selected', String(active));
            b.className = active
              ? 'cert-tab-btn inline-flex h-9 items-center gap-2 rounded-full border px-4 text-xs font-semibold transition-all cursor-pointer border-emerald-400 bg-emerald-500/20 text-emerald-300 light:text-emerald-900 shadow-[0_0_16px_rgba(16,185,129,0.25)]'
              : 'cert-tab-btn inline-flex h-9 items-center gap-2 rounded-full border px-4 text-xs font-semibold transition-all cursor-pointer border-cyan-500/20 bg-slate-900/50 light:bg-slate-100 text-theme-body hover:border-emerald-500/40 hover:text-theme-heading';
          });

          certCards.forEach((card) => {
            const cardCat = card.getAttribute('data-category');
            if (selectedCat === 'All' || cardCat === selectedCat) {
              card.classList.remove('is-hidden');
            } else {
              card.classList.add('is-hidden');
            }
          });
        });
      });

      // 8. Interactive Full-Screen Zoomable Lightbox Modal
      const lightbox = document.getElementById('cert-lightbox');
      const lightboxBackdrop = document.getElementById('lightbox-backdrop');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxImgWrapper = document.getElementById('lightbox-img-wrapper');
      const lightboxTitle = document.getElementById('lightbox-title');
      const lightboxIssuer = document.getElementById('lightbox-issuer');
      const lightboxDate = document.getElementById('lightbox-date');
      const lightboxCategory = document.getElementById('lightbox-category');
      const lightboxSummary = document.getElementById('lightbox-summary');
      const lightboxCounter = document.getElementById('lightbox-counter');
      const lightboxOpenRaw = document.getElementById('lightbox-open-raw');
      const btnClose = document.getElementById('lightbox-close');
      const btnPrev = document.getElementById('lightbox-prev');
      const btnNext = document.getElementById('lightbox-next');
      const btnZoomIn = document.getElementById('lightbox-zoom-in');
      const btnZoomOut = document.getElementById('lightbox-zoom-out');
      const btnZoomReset = document.getElementById('lightbox-zoom-reset');

      let currentCertIndex = 0;
      let currentZoom = 1;

      function applyZoom(val) {
        currentZoom = Math.min(2.5, Math.max(0.75, val));
        if (lightboxImgWrapper) {
          lightboxImgWrapper.style.transform = `scale(${currentZoom})`;
        }
        if (btnZoomReset) {
          btnZoomReset.textContent = `${Math.round(currentZoom * 100)}%`;
        }
      }

      function getVisibleCertCards() {
        const visible = certCards.filter((c) => !c.classList.contains('is-hidden'));
        return visible.length > 0 ? visible : certCards;
      }

      function renderLightboxCard(cardEl) {
        if (!cardEl) return;
        const visibleList = getVisibleCertCards();
        const posInVisible = visibleList.indexOf(cardEl);
        const imgSrc = cardEl.getAttribute('data-cert-image') || '';
        const title = cardEl.getAttribute('data-cert-title') || '';
        const issuer = cardEl.getAttribute('data-cert-issuer') || '';
        const date = cardEl.getAttribute('data-cert-date') || '';
        const category = cardEl.getAttribute('data-cert-category') || '';
        const summary = cardEl.getAttribute('data-cert-summary') || '';
        const credId = cardEl.getAttribute('data-cert-id') || '';

        applyZoom(1);

        if (lightboxImg) {
          lightboxImg.src = imgSrc;
          lightboxImg.alt = `${title} — ${issuer}`;
        }
        if (lightboxTitle) lightboxTitle.textContent = title;
        if (lightboxIssuer) {
          lightboxIssuer.textContent = credId ? `${issuer} • ID: ${credId}` : issuer;
        }
        if (lightboxDate) lightboxDate.textContent = date;
        if (lightboxCategory) lightboxCategory.textContent = category;
        if (lightboxSummary) lightboxSummary.textContent = summary;
        if (lightboxCounter) {
          lightboxCounter.textContent = `${posInVisible + 1} / ${visibleList.length}`;
        }
        if (lightboxOpenRaw) {
          lightboxOpenRaw.href = imgSrc;
        }
      }

      function openLightbox(indexInAll) {
        currentCertIndex = indexInAll;
        const targetCard = certCards[currentCertIndex];
        renderLightboxCard(targetCard);
        if (lightbox) {
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeLightbox() {
        if (lightbox) {
          lightbox.classList.add('hidden');
          lightbox.classList.remove('flex');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }
      }

      function stepLightbox(delta) {
        const visibleList = getVisibleCertCards();
        const currentCard = certCards[currentCertIndex];
        let idx = visibleList.indexOf(currentCard);
        if (idx === -1) idx = 0;
        const nextIdx = (idx + delta + visibleList.length) % visibleList.length;
        const nextCard = visibleList[nextIdx];
        currentCertIndex = certCards.indexOf(nextCard);
        renderLightboxCard(nextCard);
      }

      certCards.forEach((card, idx) => {
        card.addEventListener('click', () => openLightbox(idx));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openLightbox(idx);
          }
        });
      });

      if (btnClose) btnClose.addEventListener('click', closeLightbox);
      if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);
      if (btnPrev) btnPrev.addEventListener('click', () => stepLightbox(-1));
      if (btnNext) btnNext.addEventListener('click', () => stepLightbox(1));
      if (btnZoomIn) btnZoomIn.addEventListener('click', () => applyZoom(currentZoom + 0.25));
      if (btnZoomOut) btnZoomOut.addEventListener('click', () => applyZoom(currentZoom - 0.25));
      if (btnZoomReset) btnZoomReset.addEventListener('click', () => applyZoom(1));

      window.addEventListener('keydown', (e) => {
        if (!lightbox || lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeLightbox();
        else if (e.key === 'ArrowRight') stepLightbox(1);
        else if (e.key === 'ArrowLeft') stepLightbox(-1);
        else if (e.key === '+' || e.key === '=') applyZoom(currentZoom + 0.25);
        else if (e.key === '-') applyZoom(currentZoom - 0.25);
      });

      // 9. Contact Form Direct Mailto Dispatch
      const contactForm = document.getElementById('contact-form');
      if (contactForm) {
        contactForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const name = document.getElementById('sender-name')?.value || '';
          const subject = document.getElementById('sender-subject')?.value || '';
          const message = document.getElementById('sender-message')?.value || '';
          const mailtoUrl = `mailto:mdaslamulalam123@gmail.com?subject=${encodeURIComponent(
            subject + ' — from ' + name
          )}&body=${encodeURIComponent(message + '\n\nFrom: ' + name)}`;
          window.location.href = mailtoUrl;
        });
      }
    })();
  </script>
</Layout>
