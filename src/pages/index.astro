---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const profileEntry = await getEntry('profile', 'main');
const profile = profileEntry!.data;

const rawExperience = await getCollection('experience');
const experiences = rawExperience.sort((a, b) => a.data.order - b.data.order);

const rawAchievements = await getCollection('achievements');
const achievements = rawAchievements.sort((a, b) => a.data.order - b.data.order);

const rawCertifications = await getCollection('certifications');
const certifications = rawCertifications.sort((a, b) => a.data.order - b.data.order);

const categories = [
  'All',
  'Research & Pharma',
  'AI & Digital Health',
  'Leadership & Civic',
] as const;

function getCategoryStyle(category: string) {
  switch (category) {
    case 'Research & Pharma':
      return {
        badge: 'border-cyan-500/35 bg-cyan-500/10 text-cyan-400',
        dot: 'bg-cyan-400',
      };
    case 'AI & Digital Health':
      return {
        badge: 'border-emerald-500/35 bg-emerald-500/10 text-emerald-400',
        dot: 'bg-emerald-400',
      };
    case 'Leadership & Civic':
      return {
        badge: 'border-violet-500/35 bg-violet-500/10 text-violet-400',
        dot: 'bg-violet-400',
      };
    default:
      return {
        badge: 'border-cyan-500/35 bg-cyan-500/10 text-cyan-400',
        dot: 'bg-cyan-400',
      };
  }
}
---

<Layout>
  <!-- Top Scroll Progress Indicator -->
  <div
    class="fixed top-0 right-0 left-0 z-[70] h-[2px] bg-transparent pointer-events-none"
    aria-hidden="true"
  >
    <div
      id="scroll-progress"
      class="h-full w-0 bg-gradient-to-r from-cyan-400 via-emerald-400 to-cyan-500 shadow-[0_0_12px_rgba(6,182,212,0.85)] transition-[width] duration-75"
    >
    </div>
  </div>

  <!-- Floating Glassmorphic Sticky Navigation Bar -->
  <header class="fixed top-0 right-0 left-0 z-50 px-4 pt-3 sm:px-6 lg:px-8">
    <nav
      aria-label="Primary Navigation"
      class="mx-auto flex max-w-7xl items-center justify-between rounded-2xl border border-slate-800/80 light:border-slate-200/90 bg-slate-950/80 light:bg-white/85 px-5 py-3 backdrop-blur-xl shadow-[0_8px_32px_rgba(0,0,0,0.24)] transition-colors duration-300"
    >
      <!-- Brand Identity: Clean, Confident Typography Only -->
      <a
        href="#top"
        class="font-heading text-base sm:text-lg font-bold tracking-tight text-theme-heading hover:text-cyan-400 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 rounded-md"
      >
        {profile.name}
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-1 lg:gap-1.5">
        <a
          href="#about"
          class="rounded-full px-3.5 py-1.5 text-xs lg:text-sm font-medium text-theme-body hover:text-cyan-400 hover:bg-cyan-500/10 transition-colors"
        >
          About
        </a>
        <a
          href="#experience"
          class="rounded-full px-3.5 py-1.5 text-xs lg:text-sm font-medium text-theme-body hover:text-cyan-400 hover:bg-cyan-500/10 transition-colors"
        >
          Leadership
        </a>
        <a
          href="#achievements"
          class="rounded-full px-3.5 py-1.5 text-xs lg:text-sm font-medium text-theme-body hover:text-cyan-400 hover:bg-cyan-500/10 transition-colors"
        >
          Achievements
        </a>
        <a
          href="#certifications"
          class="rounded-full px-3.5 py-1.5 text-xs lg:text-sm font-medium text-theme-body hover:text-cyan-400 hover:bg-cyan-500/10 transition-colors"
        >
          Credentials (13)
        </a>
        <a
          href="#education"
          class="rounded-full px-3.5 py-1.5 text-xs lg:text-sm font-medium text-theme-body hover:text-cyan-400 hover:bg-cyan-500/10 transition-colors"
        >
          Education
        </a>
        <a
          href="#contact"
          class="rounded-full px-3.5 py-1.5 text-xs lg:text-sm font-medium text-theme-body hover:text-cyan-400 hover:bg-cyan-500/10 transition-colors"
        >
          Contact
        </a>
      </div>

      <!-- Right Chrome: Theme Toggle, Clean Subtle CMS Ghost Link, and CV Pill CTA -->
      <div class="flex items-center gap-2">
        <!-- Dark/Light Theme Toggle -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle Dark or Light Mode"
          title="Toggle Dark / Light Theme"
          class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-800 light:border-slate-200 bg-slate-900/60 light:bg-slate-100 text-theme-body hover:border-cyan-500/40 hover:text-cyan-400 transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
        >
          <!-- Sun Icon (shown in dark mode) -->
          <svg
            id="theme-icon-sun"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
            ></path>
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg
            id="theme-icon-moon"
            class="hidden h-4 w-4 text-slate-700"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
            ></path>
          </svg>
        </button>

        <!-- Keystatic CMS Admin Portal Ghost Link (No Pulsing Dot) -->
        <a
          href="/keystatic"
          class="hidden sm:inline-flex h-9 items-center rounded-lg px-3 text-xs font-medium text-theme-muted hover:bg-slate-800/60 light:hover:bg-slate-100 hover:text-theme-heading transition-colors"
          title="Open Keystatic CMS Admin"
        >
          CMS
        </a>

        <!-- Marketing Pill CTA: Resume / CV -->
        <a
          href={profile.cvPath}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 items-center gap-1.5 rounded-full bg-gradient-to-r from-cyan-500 to-emerald-500 px-4 text-xs font-semibold text-slate-950 shadow-sm hover:brightness-110 transition-all"
        >
          <span>CV / Resume</span>
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
            ></path>
          </svg>
        </a>

        <!-- Mobile Menu Trigger -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle Navigation Menu"
          class="flex md:hidden h-9 w-9 items-center justify-center rounded-lg border border-slate-800 light:border-slate-200 bg-slate-900/60 light:bg-slate-100 text-theme-heading"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
            ></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Navigation Drawer -->
    <div
      id="mobile-menu"
      class="hidden md:hidden mx-auto mt-2 max-w-7xl rounded-2xl border border-slate-800 light:border-slate-200 bg-slate-950/95 light:bg-white/95 p-4 backdrop-blur-xl shadow-2xl"
    >
      <div class="flex flex-col gap-2">
        <a
          href="#about"
          class="mobile-nav-link rounded-lg px-3 py-2 text-sm font-medium text-theme-heading hover:bg-cyan-500/10"
        >
          About
        </a>
        <a
          href="#experience"
          class="mobile-nav-link rounded-lg px-3 py-2 text-sm font-medium text-theme-heading hover:bg-cyan-500/10"
        >
          Leadership & Experience
        </a>
        <a
          href="#achievements"
          class="mobile-nav-link rounded-lg px-3 py-2 text-sm font-medium text-theme-heading hover:bg-cyan-500/10"
        >
          Key Achievements & Workshops
        </a>
        <a
          href="#certifications"
          class="mobile-nav-link rounded-lg px-3 py-2 text-sm font-medium text-theme-heading hover:bg-cyan-500/10"
        >
          Verified Credentials (13)
        </a>
        <a
          href="#education"
          class="mobile-nav-link rounded-lg px-3 py-2 text-sm font-medium text-theme-heading hover:bg-cyan-500/10"
        >
          Education
        </a>
        <a
          href="#contact"
          class="mobile-nav-link rounded-lg px-3 py-2 text-sm font-medium text-theme-heading hover:bg-cyan-500/10"
        >
          Contact Details
        </a>
        <a
          href="/keystatic"
          class="mobile-nav-link rounded-lg border border-slate-800 light:border-slate-200 px-3 py-2 text-xs font-medium text-theme-muted"
        >
          Open Keystatic CMS (/keystatic)
        </a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <!-- ==========================================
         HERO SECTION (Editorial, Executive & Natural Framing)
         ========================================== -->
    <section
      id="top"
      class="relative min-h-[88vh] flex items-center overflow-hidden pt-28 pb-20 lg:pt-36 lg:pb-28 bio-hex-grid"
    >
      <!-- Subtle Ambient Radial Mesh Gradient Background -->
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden"
        aria-hidden="true"
      >
        <div
          class="animate-mesh absolute -top-32 left-1/4 h-[500px] w-[500px] rounded-full bg-cyan-500/12 blur-[140px]"
        >
        </div>
        <div
          class="animate-mesh absolute top-1/4 right-10 h-[440px] w-[440px] rounded-full bg-emerald-500/10 blur-[140px]"
          style="animation-delay: -5s;"
        >
        </div>
      </div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-12">
          <!-- Left Column: Executive Copy & CTAs (7 Cols) -->
          <div class="lg:col-span-7 flex flex-col items-start text-left">
            <!-- Display Headline -->
            <h1
              class="display-tracking text-4xl sm:text-5xl lg:text-6xl font-extrabold text-theme-heading leading-[1.08] mb-4"
            >
              {profile.name}
            </h1>

            <!-- Sub-Headline -->
            <p
              class="text-base sm:text-lg lg:text-xl font-semibold text-cyan-400 light:text-cyan-700 mb-6 leading-relaxed"
            >
              {profile.headline}
            </p>

            <!-- Lead Summary -->
            <p class="text-sm sm:text-base text-theme-body leading-relaxed mb-7 max-w-2xl">
              {profile.aboutBio}
            </p>

            <!-- Clean, Understated Inline Metadata Tags with Minimal Icons (No Pulsing Neon Dots) -->
            <div class="mb-8 flex flex-wrap items-center gap-2.5">
              <div
                class="inline-flex items-center gap-2 rounded-lg border border-slate-800/90 light:border-slate-200 bg-slate-900/60 light:bg-white/90 px-3.5 py-2 text-xs font-medium text-theme-heading shadow-2xs"
              >
                <svg
                  class="h-4 w-4 text-amber-400 light:text-amber-600 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 0 0 2.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 0 1 2.916.52 6.003 6.003 0 0 1-5.395 4.972m0 0a6.726 6.726 0 0 1-2.749 1.35m0 0a6.772 6.772 0 0 1-3.044 0"
                  ></path>
                </svg>
                <span>Gold Scholar Award 2025 (UniV)</span>
              </div>

              <div
                class="inline-flex items-center gap-2 rounded-lg border border-slate-800/90 light:border-slate-200 bg-slate-900/60 light:bg-white/90 px-3.5 py-2 text-xs font-medium text-theme-heading shadow-2xs"
              >
                <svg
                  class="h-4 w-4 text-cyan-400 light:text-cyan-600 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"
                  ></path>
                </svg>
                <span>IEEE ICADHI 2026 Ambassador</span>
              </div>

              <div
                class="inline-flex items-center gap-2 rounded-lg border border-slate-800/90 light:border-slate-200 bg-slate-900/60 light:bg-white/90 px-3.5 py-2 text-xs font-medium text-theme-heading shadow-2xs"
              >
                <svg
                  class="h-4 w-4 text-emerald-400 light:text-emerald-600 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                  ></path>
                </svg>
                <span>{profile.location}</span>
              </div>
            </div>

            <!-- Marketing Pill CTAs -->
            <div class="flex flex-wrap items-center gap-3.5 w-full sm:w-auto">
              <a
                href="#certifications"
                class="inline-flex h-12 items-center justify-center gap-2.5 rounded-full bg-gradient-to-r from-cyan-500 to-emerald-500 px-7 text-sm font-semibold text-slate-950 shadow-md hover:brightness-110 transition-all"
              >
                <span>Explore 13 Verified Credentials</span>
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                  ></path>
                </svg>
              </a>

              <a
                href={profile.cvPath}
                download
                class="inline-flex h-12 items-center justify-center gap-2 rounded-full border border-slate-700/80 light:border-slate-300 bg-slate-900/75 light:bg-white px-6 text-sm font-semibold text-theme-heading hover:border-cyan-500/50 hover:bg-cyan-500/10 transition-all"
              >
                <svg
                  class="h-4 w-4 text-cyan-400 light:text-cyan-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
                  ></path>
                </svg>
                <span>Download CV</span>
              </a>

              <a
                href="#contact"
                class="inline-flex h-12 items-center justify-center gap-2 rounded-full border border-slate-800 light:border-slate-300 bg-transparent px-6 text-sm font-medium text-theme-body hover:border-cyan-500/40 hover:text-cyan-400 transition-all"
              >
                <span>Contact</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Clean, Refined Portrait Frame (5 Cols) -->
          <div class="lg:col-span-5 flex items-center justify-center lg:justify-end">
            <div class="relative w-full max-w-[320px] sm:max-w-[350px]">
              <!-- Soft Ambient Backlight Shadow -->
              <div
                class="pointer-events-none absolute -inset-3 rounded-3xl bg-gradient-to-tr from-cyan-500/15 via-slate-900/5 to-emerald-500/15 blur-2xl"
                aria-hidden="true"
              >
              </div>

              <!-- Refined Editorial Portrait Card Frame -->
              <div
                class="relative overflow-hidden rounded-2xl border border-slate-800/90 light:border-slate-200/90 bg-slate-900/60 light:bg-white/90 p-2.5 shadow-[0_20px_50px_rgba(0,0,0,0.45)] light:shadow-[0_20px_45px_rgba(15,23,42,0.1)] backdrop-blur-md"
              >
                <div class="aspect-[3/4] w-full overflow-hidden rounded-xl bg-slate-950">
                  <img
                    src={profile.profileImage}
                    alt={profile.name}
                    width="360"
                    height="480"
                    fetchpriority="high"
                    class="h-full w-full object-cover object-center transition-transform duration-500 hover:scale-[1.02]"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         BENTO GRID ARCHITECTURE: ABOUT, METRICS & CORE COMPETENCIES
         ========================================== -->
    <section id="about" class="py-20 lg:py-28 relative">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="mb-12 reveal-on-scroll">
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-2">
            <span>01 — EXECUTIVE TELEMETRY & COMPETENCIES</span>
            <span class="h-px w-12 bg-cyan-500/40"></span>
          </div>
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <h2 class="heading-tracking text-3xl sm:text-4xl font-bold text-theme-heading">
              Academic & Leadership Overview
            </h2>
          </div>
        </div>

        <!-- Bento Grid (12 Columns) -->
        <div class="grid grid-cols-1 gap-5 md:grid-cols-12">
          <!-- Metric 1: 13+ Verified Credentials (4 Cols) -->
          <div class="cyber-card p-6 md:col-span-4 reveal-on-scroll flex flex-col justify-between">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-semibold uppercase tracking-wider text-cyan-400">
                VERIFIED PORTFOLIO
              </span>
              <span class="flex h-9 w-9 items-center justify-center rounded-lg border border-cyan-500/30 bg-cyan-500/10 text-cyan-400">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                </svg>
              </span>
            </div>
            <div>
              <div class="font-heading display-tracking text-4xl sm:text-5xl font-extrabold text-theme-heading mb-1">
                13+
              </div>
              <h3 class="text-base font-bold text-theme-heading mb-1">
                Verified Credentials
              </h3>
              <p class="text-xs text-theme-body leading-relaxed">
                Certified across Pharmaceutical CADD, Bioinformatics, Systematic Review, Agentic AI, and Research Seminars.
              </p>
            </div>
          </div>

          <!-- Metric 2: 3 Leadership Roles (4 Cols) -->
          <div class="cyber-card p-6 md:col-span-4 reveal-on-scroll flex flex-col justify-between">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">
                EXECUTIVE LEADERSHIP
              </span>
